PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/nyayadrishti

# NVIDIA hosted inference (primary AI provider for detailed judgment reports and Q&A).
# Get a key from https://build.nvidia.com and paste it into backend/.env (never into frontend code).
#   Example format: NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional tuning (defaults shown)
NVIDIA_ENABLE_THINKING=false
NVIDIA_TEMPERATURE=0.2
NVIDIA_TIMEOUT_MS=180000
NVIDIA_MAX_RETRIES=4
NVIDIA_MAX_OUTPUT_TOKENS=8192
NVIDIA_CONCURRENCY=2
NVIDIA_CHUNK_CHARS=36000
NVIDIA_SYNTHESIS_MAX_CHARS=120000

# RAG for "Ask the Judgment": NVIDIA embedding model used to search judgments by meaning.
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Optional tuning (defaults shown)
RAG_CHUNK_CHARS=1400
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=8
RAG_EMBED_BATCH_SIZE=32

# Optional: Google Gemini API Key, used as a fallback if NVIDIA is not configured or fails.
# If neither key is set, NyayaDrishti runs in deterministic Indian Legal Rule-Based Demo Mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NODE_ENV=development
